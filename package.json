{
  "name": "capsule-panic",
  "version": "0.1.0",
  "private": true,
  "description": "Capsule Panic : puzzle de chute de capsules d'énergie, hors ligne.",
  "license": "MIT",
  "author": "David Sevin",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "vite apps/web",
    "build": "tsc --noEmit && vite build apps/web",
    "preview": "vite preview apps/web",
    "check:precache": "node scripts/check-precache.js",
    "check:licenses": "node scripts/check-licenses.js",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint --max-warnings=0",
    "test": "vitest run --pool=threads --maxWorkers=2 --coverage",
    "test:e2e": "playwright test"
  },
  "devDependencies": {
    "@playwright/test": "1.65.0",
    "@types/node": "26.6.6",
    "@vitest/coverage-v8": "5.1.0",
    "fast-check": "4.10.3",
    "happy-dom": "21.0.4",
    "oxlint": "1.92.0",
    "oxlint-tsgolint": "7.0.2006",
    "typescript": "7.0.2",
    "vite": "8.3.6",
    "vite-plugin-pwa": "2.0.0",
    "vitest": "5.1.0"
  }
}
